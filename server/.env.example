# 复制本文件为 .env 后填写；.env 已在 .gitignore 中，绝不可提交。
# 课堂演示建议只在本机填，GitHub Pages 那份永远不接触 Key。
# 需要 Node 18+（用到内置 fetch 与 AbortSignal.timeout）。

PORT=8787
# 默认只在本机可访问；若需同网段其他设备投屏/扫码打开，改为 0.0.0.0
# 注意：开放到局域网时，任何人都可调用你的接口，请同时设置 TSG_TOKEN；
#      课堂结束记得关掉服务。
TSG_HOST=127.0.0.1

# 兼容 OpenAI chat/completions 协议的接口地址
TSG_API_URL=https://api.deepseek.com/chat/completions
TSG_MODEL=deepseek-flash

# 必填；留空则接口仍可启动，前端自动降级为离线剧本包模式
TSG_API_KEY=

# CORS 默认关闭（只服务同源页面 http://localhost:8787，最安全）。
# 仅当从 https://<user>.github.io 跨域调用本机接口时，才填具体来源（逗号分隔）；
# 填 * 会让任何网站都能借用你的 Key，除非明确知道在做什么，不要填 *。
# 注意：https 页面请求 http://127.0.0.1 属混合内容，各浏览器策略不一，
#      课堂演示请直接访问 http://localhost:8787（同源）。
# TSG_ALLOW_ORIGIN=https://pm-yanmao.github.io

# 可选课堂口令：非空时，所有 /api/generate* 请求必须带 X-TSG-Token，
# 页面「设置 · 接口地址」里填同一个口令即可。
# 多设备课堂（TSG_HOST=0.0.0.0）强烈建议设置，否则同网段任何人可消耗你的配额。
# TSG_TOKEN=

# 每个 IP 每分钟最多生成次数（默认 30，0 = 不限）
# TSG_RATE_LIMIT=30

# 设为 off 时不把玩家输入/生成正文写入 logs/*.jsonl（课堂结束即焚）
# TSG_LOG=off
