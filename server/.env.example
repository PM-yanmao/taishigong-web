# 复制本文件为 .env 后填写；.env 已在 .gitignore 中，绝不可提交。
# 课堂演示建议只在本机填，GitHub Pages 那份永远不接触 Key。
# 需要 Node 18+（用到内置 fetch 与 AbortSignal.timeout）。

PORT=8787
# 默认只在本机可访问；若需同网段其他设备投屏/扫码打开，改为 0.0.0.0
# 注意：开放到局域网时，任何人都可调用你的接口，课堂结束记得关掉。
TSG_HOST=127.0.0.1

# 兼容 OpenAI chat/completions 协议的接口地址
TSG_API_URL=https://api.deepseek.com/chat/completions
TSG_MODEL=deepseek-flash

# 必填；留空则接口仍可启动，前端自动降级为离线剧本包模式
TSG_API_KEY=

# 从 https://<user>.github.io 跨域调用本机接口时，可收紧为具体来源
# 注意：https 页面请求 http://127.0.0.1 属混合内容，各浏览器策略不一，
#      课堂演示请直接访问 http://localhost:8787（同源）。
TSG_ALLOW_ORIGIN=*
